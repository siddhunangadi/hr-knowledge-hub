# Application
APP_NAME="HR Knowledge Hub"
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated, or ["*"] for all)
CORS_ORIGINS=["*"]

# Frontend -> Backend
BACKEND_URL=http://localhost:8000

# NVIDIA NIM embedding API (used for document ingestion)
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Pinecone (vector storage for chunk embeddings)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-knowledge-hub

# Supabase (stores documents and chunk text/metadata)
SUPABASE_URL=
SUPABASE_KEY=
