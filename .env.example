# Application
APP_NAME="HR Knowledge Hub"
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated, or ["*"] for all)
CORS_ORIGINS=["*"]

# Frontend -> Backend
BACKEND_URL=http://localhost:8000

# NVIDIA NIM embedding API (used for document ingestion and query embedding)
# Can be the same NVIDIA account as the reranker key below, or a separate one.
NVIDIA_EMBEDDING_API_KEY=
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# NVIDIA NIM reranker API (used for retrieval reranking)
NVIDIA_RERANKER_API_KEY=
NVIDIA_RERANKER_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
NVIDIA_RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2

# NVIDIA NIM text generation API (used for grounded answer generation)
NVIDIA_LLM_API_KEY=
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# Pinecone (vector storage for chunk embeddings)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-knowledge-hub

# Supabase (stores documents and chunk text/metadata)
SUPABASE_URL=
SUPABASE_KEY=
